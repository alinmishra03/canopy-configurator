# --- Server ---
# Port of the pricing/cart API. Read by BOTH the API server and the Vite /api proxy,
# so changing it here keeps them in sync. (If unset, PORT is used, then 8787.)
API_PORT=8787
# Comma-separated list of origins allowed to embed the configurator in an iframe.
# "*" allows any site to embed it.
FRAME_ANCESTORS=*

# --- Shopify (optional) ---
# Leave SHOPIFY_STORE_DOMAIN empty to use the local mock adapter.
# These are read ONLY by the Node server and are never sent to the browser.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2024-10
# JSON map from internal pricing SKU -> Shopify ProductVariant GID.
# See server/config/shopifyVariantMap.ts for the SKU list.
SHOPIFY_VARIANT_MAP=
